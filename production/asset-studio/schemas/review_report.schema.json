{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "stage",
    "author",
    "method",
    "checks",
    "artifacts",
    "defects"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "asset_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 10
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "not_run",
              "pass",
              "fail"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "category"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "category": {
            "enum": [
              "source",
              "image",
              "video",
              "audio",
              "report"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "status"],
        "properties": {
          "severity": {"enum": ["critical", "major", "minor"]},
          "status": {"enum": ["fixed", "open", "accepted_minor"]}
        },
        "if": {
          "properties": {"status": {"const": "accepted_minor"}},
          "required": ["status"]
        },
        "then": {
          "required": ["reason", "affected_use", "owner", "later_action"],
          "properties": {
            "severity": {"const": "minor"},
            "reason": {"type": "string", "pattern": "\\S"},
            "affected_use": {"type": "string", "pattern": "\\S"},
            "owner": {"type": "string", "pattern": "\\S"},
            "later_action": {"type": "string", "pattern": "\\S"}
          }
        }
      }
    },
    "executed_commands": {
      "type": "array"
    },
    "notes": {
      "type": "array"
    }
  }
}
