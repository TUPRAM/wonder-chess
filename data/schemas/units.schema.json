                "type": "number",
                "minimum": 0
              },
              "in_place": {
                "type": "boolean"
              },
              "required_clips": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "root_bone": {
                "type": "string",
                "minLength": 1
              },
              "root_motion": {
                "type": "boolean"
              },
              "socket_names": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "deformation_review_required": {
                "type": "boolean"
              }
            },
            "required": [
              "fps",
              "in_place",
              "required_clips",
              "root_bone",
              "root_motion",
              "socket_names",
              "deformation_review_required"
            ],
            "additionalProperties": false
          },
          "art_budget": {
