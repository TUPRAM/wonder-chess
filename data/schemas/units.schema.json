              },
              "material_slots_max": {
                "type": "number",
                "minimum": 0
              },
              "texture_size_default": {
                "type": "number",
                "minimum": 0
              },
              "deform_bones_target_max": {
                "type": "number",
                "minimum": 0
              },
              "skin_influences_max": {
                "type": "number",
                "minimum": 0
              },
              "lod1_target_ratio": {
                "type": "number",
                "minimum": 0
              },
              "lod2_target_ratio": {
                "type": "number",
                "minimum": 0
              },
              "budget_status": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "lod0_triangles_max",
              "material_slots_max",
              "texture_size_default",
              "deform_bones_target_max",
              "skin_influences_max",
              "lod1_target_ratio",
              "lod2_target_ratio",
              "budget_status"
            ],
            "additionalProperties": false
          },
          "model_sheet_prompt": {
            "type": "string",
            "minLength": 100
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "role_tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "tank",
                "melee",
                "ranged",
                "caster",
                "support",
                "healer",
                "control"
              ]
            }
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "title",
          "race",
          "unit_class",
          "region",
          "faction",
          "role",
          "cost",
          "rarity",
          "production_phase",
          "implementation_status",
          "height_m",
          "rig_family",
          "stats",
          "ability",
          "art",
          "biography",
          "tactics",
          "localization_status",
          "asset_paths",
          "animation_contract",
          "art_budget",
          "model_sheet_prompt",
          "display_name",
          "role_tags"
