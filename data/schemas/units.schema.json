{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.1.0"
    },
    "balance_version": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^wc_u_[a-z]+_[a-z]+$"
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "race": {
            "enum": [
              "human",
              "elf",
              "dwarf",
              "orc",
              "halfling",
              "dragonkin"
            ]
          },
          "unit_class": {
            "enum": [
              "guardian",
              "warrior",
              "ranger",
              "rogue",
              "mage",
              "priest"
            ]
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "faction": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "rarity": {
            "type": "string",
            "minLength": 1
          },
          "production_phase": {
            "const": "alpha"
          },
          "implementation_status": {
            "type": "string",
            "minLength": 1
          },
          "height_m": {
            "type": "number",
            "minimum": 0
          },
          "rig_family": {
            "type": "string",
            "minLength": 1
          },
          "stats": {
            "type": "object",
            "properties": {
              "health_cp": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              },
              "attack_damage_cp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "attack_rate_milli": {
                "type": "integer",
                "minimum": 250,
                "maximum": 2500
              },
              "attack_range_tiles": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "physical_armor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "magic_resistance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "movement_rate_milli": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "attack_delivery": {
                "enum": [
                  "melee",
                  "ranged"
                ]
              },
              "attack_damage_type": {
                "enum": [
                  "physical",
                  "magic",
                  "true"
                ]
              },
              "attack_windup_ms": {
                "type": "integer",
                "minimum": 50,
                "maximum": 350,
                "multipleOf": 50
              },
              "projectile_travel_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000,
                "multipleOf": 50
              }
            },
            "required": [
              "health_cp",
              "attack_damage_cp",
              "attack_rate_milli",
              "attack_range_tiles",
              "physical_armor",
              "magic_resistance",
              "movement_rate_milli",
              "attack_delivery",
              "attack_damage_type",
              "attack_windup_ms",
              "projectile_travel_ms"
            ],
            "additionalProperties": false
          },
          "ability": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tooltip_en": {
                "type": "string",
                "minLength": 1
              },
              "target_rule": {
                "enum": [
                  "adjacent_allies",
                  "adjacent_enemies",
                  "current_enemy",
                  "current_enemy_adjacent",
                  "current_enemy_area",
                  "farthest_enemy_adjacent",
                  "lowest_health_ally",
                  "retreat_from_current_enemy",
                  "self",
                  "highest_attack_rate_enemy"
                ]
              },
              "first_cast_ms": {
                "type": "integer",
                "minimum": 0,
                "multipleOf": 50,
                "maximum": 60000
              },
              "cooldown_ms": {
                "type": "integer",
                "minimum": 50,
                "multipleOf": 50,
                "maximum": 60000
              },
              "cast_ms": {
                "type": "integer",
                "minimum": 50,
                "multipleOf": 50,
                "maximum": 10000
              },
              "radius_tiles": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "range_tiles": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "allow_self": {
                "type": "boolean"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "recovery_ms": {
                "type": "integer",
                "minimum": 50,
                "multipleOf": 50,
                "maximum": 10000
              },
              "max_targets": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "max_dash_tiles": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "travel_ms": {
                "type": "integer",
                "minimum": 0,
                "multipleOf": 50,
                "maximum": 10000
              },
              "interrupt_policy": {
                "const": "consume_committed_cooldown_cancel_unreleased_effect"
              },
              "no_target_policy": {
                "const": "remain_ready_continue_basics"
              },
              "effect_snapshot": {
                "const": "capture_at_release_except_reserved_dash_destination"
              },
              "delivery": {
                "enum": [
                  "instant",
                  "projectile"
                ]
              },
              "tooltip_id": {
                "type": "string",
                "minLength": 1
              },
              "effects": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "properties": {
                    "effect": {
                      "enum": [
                        "damage",
                        "heal",
                        "shield",
                        "stun",
                        "dash",
                        "stat_modifier"
                      ]
                    },
                    "damage_type": {
                      "enum": [
                        "physical",
                        "magic",
                        "true",
                        null
                      ]
                    },
                    "magnitude_unit": {
                      "enum": [
                        null,
                        "basis_points",
                        "centipoints"
                      ]
                    },
                    "magnitude_by_star": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -10000,
                        "maximum": 10000000
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "stat": {
                      "enum": [
                        null,
                        "attack_rate"
                      ]
                    },
                    "duration_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "multipleOf": 50,
                      "maximum": 60000
                    }
                  },
                  "required": [
                    "effect",
                    "damage_type",
                    "magnitude_unit",
                    "magnitude_by_star",
                    "stat",
                    "duration_ms"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "tooltip_en",
              "target_rule",
              "first_cast_ms",
              "cooldown_ms",
              "cast_ms",
              "radius_tiles",
              "range_tiles",
              "allow_self",
              "id",
              "recovery_ms",
              "max_targets",
              "max_dash_tiles",
              "travel_ms",
              "interrupt_policy",
              "no_target_policy",
              "effect_snapshot",
              "delivery",
              "tooltip_id",
              "effects"
            ],
            "additionalProperties": false
          },
          "art": {
            "type": "object",
            "properties": {
              "silhouette": {
                "type": "string",
                "minLength": 35
              },
              "face": {
                "type": "string",
                "minLength": 35
              },
              "costume": {
                "type": "string",
                "minLength": 35
              },
              "palette": {
                "type": "string",
                "minLength": 35
              },
              "equipment": {
                "type": "string",
                "minLength": 35
              },
              "signature": {
                "type": "string",
                "minLength": 35
              },
              "materials": {
                "type": "string",
                "minLength": 35
              },
              "back": {
                "type": "string",
                "minLength": 35
              },
              "animation": {
                "type": "string",
                "minLength": 35
              },
              "vfx": {
                "type": "string",
                "minLength": 35
              },
              "audio": {
                "type": "string",
                "minLength": 35
              },
              "risk": {
                "type": "string",
                "minLength": 35
              }
            },
            "required": [
              "silhouette",
              "face",
              "costume",
              "palette",
              "equipment",
              "signature",
              "materials",
              "back",
              "animation",
              "vfx",
              "audio",
              "risk"
            ],
            "additionalProperties": false
          },
          "biography": {
            "type": "string",
            "minLength": 100
          },
          "tactics": {
            "type": "object",
            "properties": {
              "placement": {
                "type": "string",
                "minLength": 1
              },
              "partner": {
                "type": "string",
                "minLength": 1
              },
              "counter": {
                "type": "string",
                "minLength": 1
              },
              "weakness": {
                "type": "string",
                "minLength": 1
              },
              "contrast": {
                "type": "string",
                "minLength": 1
              },
              "test": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "placement",
              "partner",
              "counter",
              "weakness",
              "contrast",
              "test"
            ],
            "additionalProperties": false
          },
          "localization_status": {
            "type": "string",
            "minLength": 1
          },
          "asset_paths": {
            "type": "object",
