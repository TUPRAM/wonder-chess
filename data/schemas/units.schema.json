              },
              "mesh_fbx": {
                "type": "string",
                "minLength": 1
              },
              "unreal_folder": {
                "type": "string",
                "minLength": 1
              },
              "portrait": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "blender",
              "mesh_fbx",
              "unreal_folder",
              "portrait"
            ],
            "additionalProperties": false
          },
          "animation_contract": {
            "type": "object",
