        "additionalProperties": false
      },
      "minItems": 24,
      "maxItems": 24
    }
  },
  "required": [
    "schema_version",
    "balance_version",
    "units"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wonder Chess 24 playable heroes schema 3.1"
}
