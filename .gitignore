# Python local tooling
.venv/
__pycache__/
*.py[cod]
# Blender automatic save backups stay local; named revisions remain versioned.
*.blend1
# FBX exporter texture sidecars duplicate the versioned source texture maps.
/exports/**/*.fbm/
# Unreal generated caches; do NOT ignore Content or ArtSource
/game/Binaries/
/game/Intermediate/
/game/Saved/
/game/DerivedDataCache/
/game/Build/Windows/FileOpenOrder/
# Local builds and tool configuration
/builds/
.env
.env.local
*.sln
*.VC.db
# This machine's MCP paths and disposable native test build products.
/.codex/config.toml
/reports/**/*.obj
/reports/**/wonder_runtime_tests.exe
/reports/**/targeted_combat_tests.exe
/reports/**/trait_combat_tests.exe
/reports/**/measure_neutral_tuning.exe
/reports/**/measure_update_counters.exe
/reports/**/attack_windows.exe
/reports/**/baseline.exe
/reports/**/current.exe
# Keep canonical data, generated catalog, docs and source assets versioned.
